WITH
aggd1 AS (
 FIND store_sales ss, ss VIA same_store store s
 FETCH DISTINCT ss.item_sk i1, ss.ticket_number i2, s.state k1, ss.ext_sales_price c1),
aggm1 AS (FIND aggd1 x FETCH x.k1 k1, sum(x.c1) v1),
aggd2 AS (
 FIND store_sales ss, ss VIA same_store store s
 FETCH DISTINCT s.store_sk i1, s.state k1, s.number_employees c1),
aggm2 AS (FIND aggd2 x FETCH x.k1 k1, sum(x.c1) v2),
aggu AS (FIND aggm1 a FETCH a.k1 k1, a.v1 v1, to_integer(NULL) v2
 UNIONALL
 FIND aggm2 a FETCH a.k1 k1, to_decimal(NULL, 18, 4) v1, a.v2 v2)
FIND aggu t
 FETCH t.k1 state, max(t.v1) / nullif(max(t.v2), 0) per_employee