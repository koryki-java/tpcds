WITH
aggd1 AS (
 FIND store_sales ss, ss VIA same_sold_date date_dim d
 FILTER d.year = 2001
 FETCH DISTINCT ss.item_sk i1, ss.ticket_number i2, d.year k1, ss.net_profit c1, ss.ext_sales_price c2),
aggm1 AS (FIND aggd1 x FETCH x.k1 k1, sum(x.c1) v1, sum(x.c2) v2)
FIND aggm1 t
 FETCH t.k1 year, max(t.v1) / max(t.v2) margin